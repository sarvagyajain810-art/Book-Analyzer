# GEMINI_API_KEY: Optional AI Studio environment secret.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_BOOKS_API_KEY: Optional Google Books API key for higher daily quota.
# Leave empty to use anonymous Google Books requests alongside Open Library API.
GOOGLE_BOOKS_API_KEY=
